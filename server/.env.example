PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/shoppingdb
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
ADMIN_EMAIL=admin@shopeasy.com
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_NAME=Admin

# Browser origins allowed by CORS (comma separated)
CLIENT_ORIGIN=http://localhost:5173,https://localhost:5173
# Rate limits: requests per 15 min per IP / failed logins per 15 min per IP+email / sign-ups per hour per IP
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT=5
REGISTER_RATE_LIMIT=20

# Serve the API (and the Vite dev client) over HTTPS using certs/ - create them with: npm run make-cert
HTTPS=true
# SSL_KEY_PATH=certs/localhost-key.pem
# SSL_CERT_PATH=certs/localhost.pem
